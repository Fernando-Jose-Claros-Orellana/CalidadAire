  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Auth - Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "const token = json?.message || json?.token || \"\";",
                  "",
                  "pm.test(\"Token exists in response\", function () {",
                  "    pm.expect(token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "if (token) {",
                  "    pm.collectionVariables.set(\"token\", token);",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"usuarioAdmin\",\n  \"password\": \"12345\"\n}"
            },
            "url": {
              "raw": "https://localhost:7237/api/login",
              "protocol": "https",
              "host": [
                "localhost"
              ],
              "port": "7237",
              "path": [
                "api",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Lecturas",
      "item": [
        {
          "name": "Lecturas - Registrar",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200 or 201\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"Response contains lectura\", function () {",
                  "    pm.expect(json).to.have.property(\"lectura\");",
                  "});",
                  "",
                  "pm.test(\"Response has alerta property (nullable)\", function () {",
                  "    pm.expect(json).to.have.property(\"alerta\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sensorId\": 1,\n  \"pm2_5\": 80,\n  \"pm10\": 120,\n  \"co2\": 900\n}"
